# ──────────────────────────────────────────────────────────────────
# ClezJelly Environment Configuration
# ──────────────────────────────────────────────────────────────────
# Kopiere diese Datei zu .env und füll die Werte aus:
#   cp .env.example .env
# ──────────────────────────────────────────────────────────────────

# ── Timezone ──────────────────────────────────────────────────────
TZ=Europe/Vienna

# ── User/Group IDs (macOS: User=501, Group=20 ist Standard) ──────
# Prüfen mit: id -u (für PUID) und id -g (für PGID)
PUID=501
PGID=20

# ── AltMount JWT Secret ──────────────────────────────────────────
# Generieren mit: openssl rand -hex 32
# Wird beim Login signiert — bitte wirklich zufällig halten!
ALTMOUNT_JWT_SECRET=change-me-generate-with-openssl-rand-hex-32

# ──────────────────────────────────────────────────────────────────
# Die folgenden Credentials trägst du später in den Web-UIs ein,
# NICHT hier. Sie sind nur zum Nachschlagen:
# ──────────────────────────────────────────────────────────────────
#
# Usenet Provider (Eweka):
#   Host: ssl-eu.eweka.nl
#   Port: 563 (SSL)
#   Max Connections: 20
#   Username: <dein eweka username>
#   Password: <dein eweka passwort>
#
# NZBGeek Indexer:
#   URL: https://api.nzbgeek.info
#   API Key: <aus deinem Account kopieren>
#
# nzb.cat Indexer:
#   URL: https://nzb.cat
#   API Key: <aus deinem Account kopieren>
#
# ──────────────────────────────────────────────────────────────────
