# ──────────────────────────────────────────────────────────────────
# ClezJelly — environment reference
#
# You don't need to create .env yourself: ./install.sh writes it (mode 600)
# and rebuilds it on every run. This file only documents what's in there.
# ──────────────────────────────────────────────────────────────────

# Time zone and the user/group the containers run as.
# (installer: your Mac's time zone, `id -u`, `id -g`)
TZ=Europe/Vienna
PUID=501
PGID=20

# Signs AltMount's login tokens. Generated with `openssl rand -hex 32`.
ALTMOUNT_JWT_SECRET=generated-by-the-installer

# Which optional services run: seerr, bazarr, or both (comma separated).
COMPOSE_PROFILES=seerr,bazarr

# Where the published ports listen.
#   127.0.0.1  only this Mac
#   0.0.0.0    every device on your network
SEERR_BIND=0.0.0.0
ALTMOUNT_BIND=127.0.0.1

# Optional: use a different AltMount image (e.g. Intel Macs).
# ALTMOUNT_IMAGE=ghcr.io/javi11/altmount:latest

# ──────────────────────────────────────────────────────────────────
# Where your actual secrets live
#
#   .env.local        provider login, indexer keys, API keys
#                     AES-256 encrypted, unlocked with your passphrase
#   .clezjelly.conf   which optional services you picked (no secrets)
#
# Both are gitignored. Back them up with:  ./install.sh backup
# ──────────────────────────────────────────────────────────────────
