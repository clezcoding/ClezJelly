# ──────────────────────────────────────────────────────────────────
# ClezJelly .gitignore
# ──────────────────────────────────────────────────────────────────

# Credentials & Secrets — NIEMALS committen!
.env
.env.local
.env.local.bak
.env.local.*.bak
*.env
!.env.example

# Service-Configs (enthalten API-Keys, Passwörter)
config/*
!config/.gitkeep

# Daten (Media, STRM-Files, Metadata)
data/
*.db
*.sqlite
*.sqlite3

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Logs
logs/
*.log

# Backups / Swap
*.bak
*.backup
*.swp
*~

# Editor
.vscode/
.idea/
*.sublime-*
