# ──────────────────────────────────────────────────────────────────
# ClezJelly .gitignore — nothing personal ever gets committed
# ──────────────────────────────────────────────────────────────────

# Secrets and generated environment
.env
.env.*
!.env.example
*.env

# Component choices (generated per machine)
.clezjelly.conf

# Service configs (contain API keys, provider logins, databases)
config/*
!config/.gitkeep

# Runtime data (.strm files, library, caches)
data/

# Installer log
logs/

# Databases and backups
*.db
*.sqlite
*.sqlite3
*.bak
*.backup
*.tar.gz

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Editors
.vscode/
.idea/
*.swp
*~
